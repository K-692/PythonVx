{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PythonVx",
  "version": "1.0.0",
  "identifier": "com.krish.pythonvisualizer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PythonVx",
        "width": 1360,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "entitlements.plist",
      "signingIdentity": "-",
      "minimumSystemVersion": "10.15"
    },
    "shortDescription": "See your Python code run, step by step",
    "longDescription": "PythonVx is a step-by-step Python visualizer for learners: it shows variables, objects, function calls and output for every line your program runs.",
    "copyright": "Copyright (c) 2026 Krishnendu Pal. MIT License.",
    "publisher": "Krishnendu Pal"
  }
}
